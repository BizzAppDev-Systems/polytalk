# PolyTalk Configuration
# Copy this file to config.yaml and update values as needed

whisper:
  enabled: true
  mock_mode: false
  base_url: "${WHISPER_BASE_URL}"
  ws_endpoint: "${WHISPER_WS_ENDPOINT}"
  ping_interval_seconds: null
  ping_timeout_seconds: null
  max_reconnect_attempts: 3
  reconnect_delay_seconds: 2

translation:
  enabled: true
  mock_mode: false
  base_url: "${TRANSLATION_BASE_URL}"
  endpoint: "${TRANSLATION_ENDPOINT}"
  api_format: "${TRANSLATION_API_FORMAT}"
  api_key: "${TRANSLATION_API_KEY}"
  model: "${TRANSLATION_MODEL}"
  providers:
    qwen3:
      base_url: "${TRANSLATION_BASE_URL}"
      endpoint: "${TRANSLATION_ENDPOINT}"
      api_format: "${TRANSLATION_API_FORMAT}"
      api_key: "${TRANSLATION_API_KEY}"
      model: "${TRANSLATION_MODEL}"
    translategamma:
      base_url: "${TRANSLATEGAMMA_BASE_URL}"
      endpoint: "${TRANSLATEGAMMA_ENDPOINT}"
      api_format: "${TRANSLATEGAMMA_API_FORMAT}"
      api_key: "${TRANSLATEGAMMA_API_KEY}"
      model: "${TRANSLATEGAMMA_MODEL}"
  # Enable these when you want priority-based language routing. Without
  # routing, the flat translation settings above remain the active default.
  # default_provider: qwen3
  # routing:
  #   - priority: 10
  #     target_langs: [gu, hi, mr]
  #     provider: translategamma
  #   - priority: 20
  #     source_langs: [en]
  #     provider: qwen3
  temperature: 0.0
  max_tokens: "${TRANSLATION_MAX_TOKENS}"
  context_enabled: true
  context_max_chunks: 4
  context_max_chars: 1200
  context_payload_warn_chars: 2000
  custom_instruction_max_chars: "${CUSTOM_INSTRUCTION_MAX_CHARS}"
  system_prompt: "You are a professional translator. Translate from {source_language} to {target_language}. Write natural, fluent {target_language}. Preserve the meaning only; do not add explanations, summaries, repeated text, or source-language commentary. If the source transcript is fragmented, translate the intended meaning as faithfully as possible. Return ONLY the translation."

visual_context:
  enabled: "${VISUAL_CONTEXT_ENABLED}"
  mock_mode: "${VISUAL_CONTEXT_MOCK_MODE}"
  base_url: "${VISUAL_CONTEXT_BASE_URL}"
  endpoint: "${VISUAL_CONTEXT_ENDPOINT}"
  api_format: "${VISUAL_CONTEXT_API_FORMAT}"
  api_key: "${VISUAL_CONTEXT_API_KEY}"
  model: "${VISUAL_CONTEXT_MODEL}"
  temperature: 0.0
  max_tokens: "${VISUAL_CONTEXT_MAX_TOKENS}"
  max_summary_chars: 1200
  max_image_chars: 1500000

tts:
  enabled: true
  mock_mode: false
  provider: "piper"
  base_url: "${TTS_BASE_URL}"
  providers:
    piper:
      base_url: "${TTS_BASE_URL}"
    supertonic:
      base_url: "${SUPERTONIC_TTS_BASE_URL}"
      voice: "${SUPERTONIC_TTS_VOICE}"
      steps: "${SUPERTONIC_TTS_STEPS}"
      speed: "${SUPERTONIC_TTS_SPEED}"
      response_format: "wav"
      voices:
        ja: "${SUPERTONIC_TTS_JA_VOICE}"
        ko: "${SUPERTONIC_TTS_KO_VOICE}"
  language_providers:
    ar: "supertonic"
    bg: "supertonic"
    hr: "supertonic"
    et: "supertonic"
    hi: "supertonic"
    ru: "supertonic"
    id: "supertonic"
    vi: "supertonic"
    pt: "supertonic"
    pl: "supertonic"
    uk: "supertonic"
    sv: "supertonic"
    da: "supertonic"
    fi: "supertonic"
    cs: "supertonic"
    el: "supertonic"
    hu: "supertonic"
    lv: "supertonic"
    lt: "supertonic"
    sk: "supertonic"
    sl: "supertonic"
    ja: "supertonic"
    ko: "supertonic"
  voice: "en_GB-jenny_dioco-medium"
  timeout_seconds: 10
  length_scales:
    default: 0.9
    gu: 0.75
  default_voices:
    en: "en_GB-jenny_dioco-medium"
    de: "de_DE-karlsson-low"
    es: "es_ES-davefx-medium"
    es_MX: "es_MX-claude-high"
    fr: "fr_FR-siwis-medium"
    gu: "gu_IN-aikosh_female-medium"
    it: "it_IT-paola-medium"
    ml: "ml_IN-arjun-medium"
    nl: "nl_NL-ronnie-medium"
    nl_BE: "nl_BE-nathalie-medium"
    ro: "ro_RO-mihai-medium"
    tr: "tr_TR-dfki-medium"
    zh: "zh_CN-huayan-medium"

app:
  host: "${APP_HOST}"
  port: "${APP_PORT}"
  debug: "${APP_DEBUG}"
  save_media: true
  media_output_dir: "media/output"
  auto_play_audio: true
  max_audio_seconds: 300
  language_swap_delay_ms: 200
  translation_flush_chars: "${TRANSLATION_FLUSH_CHARS}"
  translation_flush_seconds: "${TRANSLATION_FLUSH_SECONDS}"
  translation_flush_min_chars: "${TRANSLATION_FLUSH_MIN_CHARS}"
