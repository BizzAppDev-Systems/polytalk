# PolyTalk Configuration
# Copy this file to config.yaml and update values as needed

whisper:
  enabled: true
  mock_mode: false
  base_url: "${WHISPER_BASE_URL}"
  ws_endpoint: "${WHISPER_WS_ENDPOINT}"
  ping_interval_seconds: null
  ping_timeout_seconds: null
  max_reconnect_attempts: 3
  reconnect_delay_seconds: 2
  routing_enabled: "${STT_ROUTING_ENABLED}"
  fallback_provider: whisper
  fallback_replay_max_seconds: "${STT_FALLBACK_REPLAY_MAX_SECONDS}"
  providers:
    whisper:
      enabled: true
      base_url: "${WHISPER_BASE_URL}"
      ws_endpoint: "${WHISPER_WS_ENDPOINT}"
    indicconformer:
      enabled: "${INDIC_STT_ENABLED}"
      base_url: "${INDIC_STT_BASE_URL}"
      ws_endpoint: "/v1/stream/transcriptions"
    parakeet:
      enabled: "${PARAKEET_STT_ENABLED}"
      base_url: "${PARAKEET_STT_BASE_URL}"
      ws_endpoint: "/v1/stream/transcriptions"
    sensevoice:
      enabled: "${SENSEVOICE_STT_ENABLED}"
      base_url: "${SENSEVOICE_STT_BASE_URL}"
      ws_endpoint: "/v1/stream/transcriptions"
  routing:
    - priority: 10
      provider: indicconformer
      languages: [as, bn, brx, doi, gu, hi, kn, kok, ks, mai, ml, mni, mr, ne, or, pa, sa, sat, sd, ta, te, ur]
    - priority: 20
      provider: sensevoice
      languages: [zh, yue, ja, ko]
    - priority: 30
      provider: parakeet
      languages: [en, bg, hr, cs, da, nl, et, fi, fr, de, el, hu, it, lv, lt, mt, pl, pt, ro, sk, sl, es, sv, ru, uk]

# Shared server-side voice activity detection. Keep profiles off until their
# shadow/boundary rollout has passed the recorded-audio regression gates.
vad:
  model_path: "app/assets/silero_vad.onnx"
  positive_threshold: 0.5
  negative_threshold: 0.35
  pre_roll_ms: 640
  start_confirm_ms: 96
  post_roll_ms: 320
  max_utterance_seconds: 30
  profiles:
    conversation:
      mode: "${VAD_CONVERSATION_MODE}"
      end_hangover_ms: 960
    live_microphone:
      mode: "${VAD_LIVE_MICROPHONE_MODE}"
      end_hangover_ms: 1600
    share:
      mode: "${VAD_SHARE_MODE}"
      end_hangover_ms: 1920

translation:
  enabled: true
  mock_mode: false
  base_url: "${TRANSLATION_BASE_URL}"
  endpoint: "${TRANSLATION_ENDPOINT}"
  api_format: "${TRANSLATION_API_FORMAT}"
  api_key: "${TRANSLATION_API_KEY}"
  model: "${TRANSLATION_MODEL}"
  providers:
    qwen3:
      base_url: "${TRANSLATION_BASE_URL}"
      endpoint: "${TRANSLATION_ENDPOINT}"
      api_format: "${TRANSLATION_API_FORMAT}"
      api_key: "${TRANSLATION_API_KEY}"
      model: "${TRANSLATION_MODEL}"
    # "translategamma" is an operator-defined provider ID retained for
    # deployment compatibility. Configure its API adapter as
    # TRANSLATEGAMMA_API_FORMAT=translategemma_chat.
    # See README.md#translation for provider ID and API adapter details.
    translategamma:
      base_url: "${TRANSLATEGAMMA_BASE_URL}"
      endpoint: "${TRANSLATEGAMMA_ENDPOINT}"
      api_format: "${TRANSLATEGAMMA_API_FORMAT}"
      api_key: "${TRANSLATEGAMMA_API_KEY}"
      model: "${TRANSLATEGAMMA_MODEL}"
  # Enable these when you want priority-based language routing. Without
  # routing, the flat translation settings above remain the active default.
  # default_provider: qwen3
  # routing:
  #   - priority: 10
  #     target_langs: [as, bn, gu, hi, kn, ml, mr, or, pa, ta, te, ur]
  #     provider: translategamma
  #   - priority: 20
  #     source_langs: [as, bn, gu, hi, kn, ml, mr, or, pa, ta, te, ur]
  #     target_langs: [en]
  #     provider: translategamma
  temperature: 0.0
  max_tokens: "${TRANSLATION_MAX_TOKENS}"
  semantic_boundary_enabled: "${SEMANTIC_BOUNDARY_ENABLED}"
  semantic_boundary_provider: "${SEMANTIC_BOUNDARY_PROVIDER}"
  semantic_boundary_timeout_seconds: "${SEMANTIC_BOUNDARY_TIMEOUT_SECONDS}"
  semantic_boundary_min_confidence: "${SEMANTIC_BOUNDARY_MIN_CONFIDENCE}"
  semantic_boundary_max_tokens: "${SEMANTIC_BOUNDARY_MAX_TOKENS}"
  semantic_boundary_disable_thinking: "${SEMANTIC_BOUNDARY_DISABLE_THINKING}"
  semantic_boundary_chat_template_kwargs_enabled: "${SEMANTIC_BOUNDARY_CHAT_TEMPLATE_KWARGS_ENABLED}"
  semantic_boundary_probe_cooldown_seconds: "${SEMANTIC_BOUNDARY_PROBE_COOLDOWN_SECONDS}"
  context_enabled: true
  context_max_chunks: 4
  context_max_chars: 1200
  context_payload_warn_chars: 2000
  custom_instruction_max_chars: "${CUSTOM_INSTRUCTION_MAX_CHARS}"
  system_prompt: "You are a professional translator. Translate from {source_language} to {target_language}. Write natural, fluent {target_language}. Preserve the meaning only; do not add explanations, summaries, repeated text, or source-language commentary. If the source transcript is fragmented, translate the intended meaning as faithfully as possible.\n\nReturn the translation text. IMMEDIATELY after the translation, on a new line, append ###TRANSLATION_END###{{\"translation_quality\": 0.XX}} where X.X is a float between 0.0 and 1.0 representing your confidence in the translation quality. This JSON block is REQUIRED and must be included at the end of every response. Do NOT omit it.\n\nExample output:\n{{translation text here}}\n###TRANSLATION_END###{{\"translation_quality\": 0.95}}"

visual_context:
  enabled: "${VISUAL_CONTEXT_ENABLED}"
  mock_mode: "${VISUAL_CONTEXT_MOCK_MODE}"
  base_url: "${VISUAL_CONTEXT_BASE_URL}"
  endpoint: "${VISUAL_CONTEXT_ENDPOINT}"
  api_format: "${VISUAL_CONTEXT_API_FORMAT}"
  api_key: "${VISUAL_CONTEXT_API_KEY}"
  model: "${VISUAL_CONTEXT_MODEL}"
  temperature: 0.0
  max_tokens: "${VISUAL_CONTEXT_MAX_TOKENS}"
  max_summary_chars: 1200
  max_image_chars: 1500000

tts:
  enabled: true
  mock_mode: false
  provider: "piper"
  base_url: "${TTS_BASE_URL}"
  providers:
    piper:
      base_url: "${TTS_BASE_URL}"
    indic_parler:
      base_url: "${INDIC_PARLER_TTS_BASE_URL}"
      gender: "${INDIC_PARLER_TTS_GENDER}"
      voice: "${INDIC_PARLER_TTS_VOICE}"
      pace: "${INDIC_PARLER_TTS_PACE}"
      paces:
        gu: "${INDIC_PARLER_TTS_GU_PACE}"
        or: "${INDIC_PARLER_TTS_OR_PACE}"
      speed: "${INDIC_PARLER_TTS_SPEED}"
      speeds:
        gu: "${INDIC_PARLER_TTS_GU_SPEED}"
        or: "${INDIC_PARLER_TTS_OR_SPEED}"
      description: "${INDIC_PARLER_TTS_DESCRIPTION}"
      timeout_seconds: "${INDIC_PARLER_TTS_TIMEOUT}"
    supertonic:
      base_url: "${SUPERTONIC_TTS_BASE_URL}"
      voice: "${SUPERTONIC_TTS_VOICE}"
      steps: "${SUPERTONIC_TTS_STEPS}"
      speed: "${SUPERTONIC_TTS_SPEED}"
      response_format: "wav"
      voices:
        ja: "${SUPERTONIC_TTS_JA_VOICE}"
        ko: "${SUPERTONIC_TTS_KO_VOICE}"
  fallback_provider: piper
  language_providers:
    as: "indic_parler"
    bn: "indic_parler"
    brx: "indic_parler"
    gu: "indic_parler"
    hi: "indic_parler"
    kn: "indic_parler"
    ml: "indic_parler"
    mni: "indic_parler"
    mr: "indic_parler"
    or: "indic_parler"
    pa: "indic_parler"
    ta: "indic_parler"
    te: "indic_parler"
    ur: "indic_parler"
    ar: "supertonic"
    bg: "supertonic"
    hr: "supertonic"
    et: "supertonic"
    ru: "supertonic"
    id: "supertonic"
    vi: "supertonic"
    pt: "supertonic"
    pl: "supertonic"
    uk: "supertonic"
    sv: "supertonic"
    da: "supertonic"
    fi: "supertonic"
    cs: "supertonic"
    el: "supertonic"
    hu: "supertonic"
    lv: "supertonic"
    lt: "supertonic"
    sk: "supertonic"
    sl: "supertonic"
    ja: "supertonic"
    ko: "supertonic"
  voice: "en_GB-jenny_dioco-medium"
  timeout_seconds: 10
  length_scales:
    default: 0.9
    gu: 0.75
  default_voices:
    en: "en_GB-jenny_dioco-medium"
    de: "de_DE-karlsson-low"
    es: "es_ES-davefx-medium"
    es_MX: "es_MX-claude-high"
    fr: "fr_FR-siwis-medium"
    gu: "gu_IN-aikosh_female-medium"
    it: "it_IT-paola-medium"
    ml: "ml_IN-arjun-medium"
    nl: "nl_NL-ronnie-medium"
    nl_BE: "nl_BE-nathalie-medium"
    ro: "ro_RO-mihai-medium"
    tr: "tr_TR-dfki-medium"
    zh: "zh_CN-huayan-medium"

app:
  host: "${APP_HOST}"
  port: "${APP_PORT}"
  debug: "${APP_DEBUG}"
  save_media: true
  media_output_dir: "media/output"
  auto_play_audio: true
  max_audio_seconds: 300
  language_swap_delay_ms: 200
  translation_flush_chars: "${TRANSLATION_FLUSH_CHARS}"
  translation_flush_seconds: "${TRANSLATION_FLUSH_SECONDS}"
  translation_flush_min_chars: "${TRANSLATION_FLUSH_MIN_CHARS}"
  translation_pause_commit_mode: "${TRANSLATION_PAUSE_COMMIT_MODE}"
  translation_semantic_hard_seconds: "${TRANSLATION_SEMANTIC_HARD_SECONDS}"
